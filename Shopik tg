async def main() -> None:
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s | %(levelname)s | %(name)s | %(message)s",
        handlers=[logging.FileHandler("bot.log", encoding="utf-8"), logging.StreamHandler()],
    )
    await init_db()
    bot = Bot(token=BOT_TOKEN, default=DefaultBotProperties(parse_mode=ParseMode.HTML))
    dp = Dispatcher(storage=MemoryStorage())
    # Порядок важен: common (/start, /cancel) и админ-роутер идут раньше пользовательского
    dp.include_routers(common, admin, user)

    poller = asyncio.create_task(payments_poller(bot))
    try:
        await bot.delete_webhook(drop_pending_updates=True)
        log.info("Бот запущен (CryptoBot: %s)", "TESTNET" if CRYPTOBOT_TESTNET else "боевая сеть")
        await dp.start_polling(bot)
    finally:
        poller.cancel()
        await bot.session.close()


if __name__ == "__main__":
    try:
        asyncio.run(main())
    except (KeyboardInterrupt, SystemExit):
        pass
