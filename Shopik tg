@admin.callback_query(BroadcastStates.confirm, F.data == "bc_send")
async def cb_bc_send(call: CallbackQuery, state: FSMContext):
    data = await state.get_data()
    await state.clear()
    await call.message.edit_reply_markup(reply_markup=None)
    ok = fail = 0
    for tg_id in await all_user_tg_ids():
        try:
            await call.bot.copy_message(tg_id, data["chat_id"], data["message_id"])
            ok += 1
        except TelegramRetryAfter as e:
            await asyncio.sleep(e.retry_after)
            try:
                await call.bot.copy_message(tg_id, data["chat_id"], data["message_id"])
                ok += 1
            except Exception:
                fail += 1
        except Exception:
            fail += 1
        await asyncio.sleep(0.05)  # лимит Telegram ~30 сообщений/сек
    await call.message.answer(f"📢 Рассылка завершена.\n✅ Доставлено: {ok}\n❌ Не доставлено: {fail}",
                              reply_markup=kb_admin_back())
    await call.answer()


