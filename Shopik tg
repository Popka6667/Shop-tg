@user.callback_query(F.data.startswith("check:"))
async def cb_check(call: CallbackQuery):
    order = await get_order(int(call.data.split(":")[1]))
    if not order or (order["tg_id"] != call.from_user.id and call.from_user.id not in ADMIN_IDS):
        await call.answer("Заказ не найден", show_alert=True)
        return
    if order["status"] != "pending":
        msg = ("✅ Оплата уже получена. Ожидайте выдачи аккаунта администратором."
               if order["status"] == "paid" else f"Статус заказа: {STATUS_LABELS[order['status']]}")
        await call.answer(msg, show_alert=True)
        return
    try:
        res = await crypto_check_status(order["payment_id"])
    except Exception:
        log.exception("Ошибка проверки заказа #%s", order["id"])
        await call.answer("⚠️ Не удалось проверить оплату, попробуйте через минуту.", show_alert=True)
        return

    if res["status"] == "paid":
        await process_paid(call.bot, order["id"], res["amount"], res["currency"], res["raw"])
        await call.answer("✅ Оплата подтверждена!")
        try:
            await call.message.edit_reply_markup(reply_markup=None)
        except Exception:
            pass
    elif res["status"] == "failed":
        await process_failed(call.bot, order["id"], res["raw"])
        await call.answer("❌ Счёт истёк или отменён.", show_alert=True)
    else:
        await call.answer("Оплата пока не найдена. Если вы уже оплатили — подождите минуту "
                          "и нажмите снова.", show_alert=True)


