@admin.message(ProductStates.edit_value, F.text)
async def msg_edit(message: Message, state: FSMContext):
    data = await state.get_data()
    field, cid = data["field"], data["cid"]
    raw = message.text.strip()
    try:
        if field == "price":
            value = float(raw.replace(",", "."))
            if value <= 0:
                raise ValueError
        elif field == "stock":
            value = int(raw)
            if value < 0:
                raise ValueError
        else:
            value = raw
            if not value:
                raise ValueError
    except ValueError:
        await message.answer("❌ Некорректное значение, попробуйте ещё раз.")
        return
    # в БД название флага хранится в flag_emoji, остальные поля совпадают по имени
    await update_country_field(cid, field, value)
    await state.clear()
    if field == "stock":
        await notify_stock(message.bot, cid)
    c = await get_country(cid)
    await message.answer("✅ Сохранено.\n\n" + country_text(c), reply_markup=kb_admin_country(c))


