class CryptoBotError(Exception):
    pass


async def _crypto_call(method: str, http: str = "GET", params: dict | None = None, body: dict | None = None):
    headers = {"Crypto-Pay-API-Token": CRYPTOBOT_API_TOKEN}
    timeout = aiohttp.ClientTimeout(total=20)
    async with aiohttp.ClientSession(timeout=timeout) as session:
        async with session.request(http, f"{CRYPTOBOT_URL}/{method}", headers=headers,
                                   params=params, json=body) as resp:
            data = await resp.json(content_type=None)
    if not data.get("ok"):
        raise CryptoBotError(str(data.get("error", data)))
    return data["result"]


async def crypto_create_invoice(order_id: int, amount_rub: float, description: str) -> dict:
    """POST /createInvoice. Сумма в RUB — CryptoBot сам конвертирует в выбранную клиентом монету."""
    body = {
        "currency_type": "fiat",
        "fiat": "RUB",
        "accepted_assets": CRYPTOBOT_ACCEPTED_ASSETS,
        "amount": f"{amount_rub:.2f}",
        "description": description[:1024],
        "payload": str(order_id),
        "allow_comments": False,
        "allow_anonymous": False,
        "expires_in": INVOICE_TTL,
    }
    inv = await _crypto_call("createInvoice", "POST", body=body)
    url = inv.get("bot_invoice_url") or inv.get("pay_url")
    return {"payment_id": str(inv["invoice_id"]), "url": url, "raw": inv}


async def crypto_check_status(invoice_id: str) -> dict:
    """GET /getInvoices?invoice_ids=... -> нормализованный статус paid / pending / failed."""
    result = await _crypto_call("getInvoices", "GET", params={"invoice_ids": str(invoice_id)})
    items = result.get("items", []) if isinstance(result, dict) else result
    if not items:
        raise CryptoBotError(f"Счёт {invoice_id} не найден")
    inv = items[0]
    st = inv.get("status")
    status = "paid" if st == "paid" else "failed" if st == "expired" else "pending"
    amount = float(inv.get("paid_amount") or inv.get("amount") or 0)
    currency = inv.get("paid_asset") or inv.get("fiat") or inv.get("asset") or "RUB"
    return {"status": status, "amount": amount, "currency": currency, "raw": inv}


