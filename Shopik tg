# ════════════════════════════════════════════════════════════
async def process_paid(bot: Bot, order_id: int, amount: float, currency: str, raw: dict | None) -> bool:
    """Идемпотентно переводит заказ в 'paid', уведомляет пользователя и админов."""
    changed = await mark_order_paid(order_id)
    await update_payment_log(order_id, "paid", raw)
    if not changed:
        return False  # уже обработан (поллер и кнопка «Я оплатил» сработали одновременно)

    order = await get_order(order_id)
    await decrement_stock(order["country_id"])

    try:
        await bot.send_message(
            order["tg_id"],
            f"✅ <b>Оплата получена!</b>\n\nАккаунт будет выдан администратором в течение "
            f"<b>{ISSUE_MINUTES}</b> минут.\n📦 Номер заказа: <b>#{order_id}</b>")
    except Exception:
        log.exception("Не удалось уведомить пользователя о заказе #%s", order_id)

    text = ("💰 <b>Новый оплаченный заказ!</b>\n\n" + order_admin_text(order)
            + f"\n🧾 Получено: {amount:g} {esc(currency)}")
    for admin_id in ADMIN_IDS:
        try:
            await bot.send_message(admin_id, text, reply_markup=kb_issue(order_id))
        except Exception:
            log.exception("Не удалось уведомить админа %s", admin_id)
    return True


async def process_failed(bot: Bot, order_id: int, raw: dict | None) -> None:
    ok = await set_order_status_if(order_id, ("pending",), "rejected")
    await update_payment_log(order_id, "failed", raw)
    if ok:
        order = await get_order(order_id)
        try:
            await bot.send_message(
                order["tg_id"],
                f"❌ Счёт по заказу <b>#{order_id}</b> истёк или был отменён. Оформите заказ заново: /start")
        except Exception:
            pass


async def notify_stock(bot: Bot, country_id: int) -> None:
    """Уведомляет подписчиков, что страна снова в наличии."""
    c = await get_country(country_id)
    if not c or c["stock"] <= 0 or not c["is_active"]:
        return
    for tg_id in await pop_notifications(country_id):
        try:
            await bot.send_message(
                tg_id, f"🔔 {esc(c['flag_emoji'])} <b>{esc(c['name'])}</b> снова в наличии! "
                       f"Цена: {fmt_price(c['price'])}", reply_markup=kb_stock_notify(country_id))
            await asyncio.sleep(0.05)
        except Exception:
            pass


async def payments_poller(bot: Bot) -> None:
    """Фоновая проверка неоплаченных заказов через API CryptoBot."""
    while True:
        try:
            await asyncio.sleep(POLL_INTERVAL)
            for o in await get_pending_orders():
                try:
                    res = await crypto_check_status(o["payment_id"])
                    if res["status"] == "paid":
                        await process_paid(bot, o["id"], res["amount"], res["currency"], res["raw"])
                    elif res["status"] == "failed":
                        await process_failed(bot, o["id"], res["raw"])
                except Exception:
                    log.exception("Ошибка проверки заказа #%s", o["id"])
            await expire_old_pending(PENDING_EXPIRE_HOURS)
        except asyncio.CancelledError:
            raise
        except Exception:
            log.exception("Ошибка в поллере платежей")


